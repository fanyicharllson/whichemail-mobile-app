# Appwrite Configuration
# IMPORTANT: This is a template file. Create a .env file with your actual values.
# After grading, you can change these keys in your Appwrite dashboard.

EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here
EXPO_PUBLIC_APPWRITE_DATABASE_ID=your_database_id_here
EXPO_PUBLIC_APPWRITE_SERVICES_COLLECTION_ID=your_services_collection_id_here
EXPO_PUBLIC_APPWRITE_CATEGORIES_COLLECTION_ID=your_categories_collection_id_here
EXPO_PUBLIC_APPWRITE_BUCKET_ID=your_bucket_id_here

