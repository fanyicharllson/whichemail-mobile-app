{
  "expo": {
    "name": "WhichEmail",
    "slug": "whichemail",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_v2.png",
    "scheme": "whichemail",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo_v3.png",
      "resizeMode": "contain",
      "backgroundColor": "#3b82f6"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fanyicharllson.whichemail",
      "backgroundColor": "#3b82f6"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3b82f6",
        "foregroundImage": "./assets/images/logo_v2.png"
      },
      "package": "com.fanyicharllson.whichemail",
      "backgroundColor": "#3b82f6",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo_v2.png",
      "backgroundColor": "#3b82f6"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_v3.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3b82f6",
          "dark": {
            "image": "./assets/images/logo_v2.png",
            "backgroundColor": "#1e40af"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow WhichEmail to use Face ID for secure password access"
        }
      ],
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "jsm-oa"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c58d060-6d69-4562-a7ae-607574032b56"
      },
      "APPWRITE_PROJECT_ID": "your_project_id_here",
      "APPWRITE_PROJECT_NAME": "WhichEmail",
      "APPWRITE_ENDPOINT": "https://fra.cloud.appwrite.io/v1",
      "APPWRITE_PACKAGE_NAME": "com.fanyicharllson.whichemail",
      "APPWRITE_DATABASE_ID": "your_database_id_here",
      "APPWRITE_TABLE_USER_ID": "users",
      "APPWRITE_TABLE_SERVICE_ID": "services",
      "APPWRITE_TABLE_FEEDBACK_ID": "feedback",
      "GEMINI_API_KEY": "your_gemini_api_key_here",
      "GEMINI_API_URL": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
      "SENTRY_AUTH_TOKEN": "your_sentry_token_here"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2c58d060-6d69-4562-a7ae-607574032b56"
    }
  }
}
